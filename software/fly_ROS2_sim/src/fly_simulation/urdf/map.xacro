<?xml version="1.0"?>
<robot name="map_world" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="ground_color">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  <material name="obstacle_color">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>

  <link name="ground">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="50 50 0.02"/>
      </geometry>
      <material name="ground_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="50 50 0.02"/>
      </geometry>
    </collision>
  </link>

  <link name="obstacle_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2 2 4"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="2 2 4"/>
      </geometry>
    </collision>
  </link>
  <joint name="obstacle_1_joint" type="fixed">
    <parent link="ground"/>
    <child link="obstacle_1"/>
    <origin xyz="10 10 2" rpy="0 0 0"/>
  </joint>

  <link name="obstacle_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="3 3 3"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="3 3 3"/>
      </geometry>
    </collision>
  </link>
  <joint name="obstacle_2_joint" type="fixed">
    <parent link="ground"/>
    <child link="obstacle_2"/>
    <origin xyz="20 15 1.5" rpy="0 0 0"/>
  </joint>

  <link name="obstacle_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="4 2 5"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="4 2 5"/>
      </geometry>
    </collision>
  </link>
  <joint name="obstacle_3_joint" type="fixed">
    <parent link="ground"/>
    <child link="obstacle_3"/>
    <origin xyz="30 5 2.5" rpy="0 0 0"/>
  </joint>

  <link name="obstacle_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2 4 2"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="2 4 2"/>
      </geometry>
    </collision>
  </link>
  <joint name="obstacle_4_joint" type="fixed">
    <parent link="ground"/>
    <child link="obstacle_4"/>
    <origin xyz="15 30 1" rpy="0 0 0"/>
  </joint>

  <link name="obstacle_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="5 1 3"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="5 1 3"/>
      </geometry>
    </collision>
  </link>
  <joint name="obstacle_5_joint" type="fixed">
    <parent link="ground"/>
    <child link="obstacle_5"/>
    <origin xyz="40 40 1.5" rpy="0 0 0"/>
  </joint>

  <link name="uav_start">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.5" length="0.01"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
  </link>
  <joint name="uav_start_joint" type="fixed">
    <parent link="ground"/>
    <child link="uav_start"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <link name="goal">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.5" length="0.01"/>
      </geometry>
      <material name="obstacle_color"/>
    </visual>
  </link>
  <joint name="goal_joint" type="fixed">
    <parent link="ground"/>
    <child link="goal"/>
    <origin xyz="40 45 0.005" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find fly_simulation)/urdf/quadrotor.xacro"/>

  <xacro:quad_body_material/>

  <xacro:quadrotor_base parent_link="uav_start">
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </xacro:quadrotor_base>

</robot>
