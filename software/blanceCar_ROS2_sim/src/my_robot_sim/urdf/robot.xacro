<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 1. 常量定义 -->
  <xacro:property name="box_length" value="0.4" />
  <xacro:property name="box_width" value="0.2" />
  <xacro:property name="box_height" value="0.1" />  <!-- 增加高度 -->

  <!-- 2. 长方体基座连杆 -->
  <link name="base_link">
    <visual>
      <geometry><box size="${box_length} ${box_width} ${box_height}" /></geometry>
      <material name="blue"><color rgba="0 0 1 1" /></material>
    </visual>
    <!-- 车身碰撞检测（无摩擦） -->
    <collision>
      <geometry><box size="${box_length} ${box_width} ${box_height}" /></geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.0</mu>     <!-- 静摩擦系数为0 -->
            <mu2>0.0</mu2>   <!-- 动摩擦系数为0 -->
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="3.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
  </link>

  <!-- 左侧车轮连杆 -->
  <link name="left_wheel">
    <visual>
      <geometry><cylinder length="0.05" radius="0.08" /></geometry>
      <material name="black"><color rgba="0 0 0 1" /></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.08" /></geometry>
      <surface>
        <friction>
          <ode>
            <mu>1000</mu>
            <mu2>500</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- 左侧车轮关节 -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 ${-box_width/2 - 0.02} ${-box_height/2 - 0.03}" rpy="1.570796 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- 右侧车轮连杆 -->
  <link name="right_wheel">
    <visual>
      <geometry><cylinder length="0.05" radius="0.08" /></geometry>
      <material name="black"><color rgba="0 0 0 1" /></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.08" /></geometry>
      <surface>
        <friction>
          <ode>
            <mu>1000</mu>
            <mu2>500</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- 右侧车轮关节 -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 ${box_width/2 + 0.02} ${-box_height/2 - 0.03}" rpy="1.570796 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- 3. Gazebo插件配置 -->
  <gazebo>
    <material>Gazebo/Blue</material>
    
    <!-- 关节状态发布插件 -->
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=/joint_states</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

    <!-- 差速驱动插件 -->
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>100.0</update_rate>
      <robot_base_frame>base_link</robot_base_frame>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>${box_width + 0.05}</wheel_separation>
      <wheel_diameter>${0.16}</wheel_diameter>
      <torque>20</torque>
      <max_wheel_acceleration>50.0</max_wheel_acceleration>
      <wheel_acceleration>30.0</wheel_acceleration>
      <command_topic>/cmd_vel</command_topic>
      <odometry_topic>/odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_joint_state>false</publish_wheel_joint_state>
      <legacy_mode>false</legacy_mode>
      <use_encoders>false</use_encoders>
    </plugin>
  </gazebo>
  <!-- 车身空气阻力配置 -->
  <gazebo reference="base_link">
    <damping>
      <linear>0.08</linear>   <!-- 线性阻尼系数（类似空气阻力） -->
      <angular>0.03</angular> <!-- 角阻尼系数 -->
    </damping>
    <sensor name="imu_sensor" type="imu">
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <remapping>~/out:=/imu</remapping>
        <frame_name>base_link</frame_name>
      </plugin>
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
    </sensor>
  </gazebo>
  
  <!-- 左侧车轮空气阻力配置 -->
  <gazebo reference="left_wheel">
    <damping>
      <linear>0.02</linear>   <!-- 车轮线性阻尼 -->
      <angular>0.01</angular> <!-- 车轮角阻尼 -->
    </damping>
  </gazebo>
  
  <!-- 右侧车轮空气阻力配置 -->
  <gazebo reference="right_wheel">
    <damping>
      <linear>0.02</linear>   <!-- 车轮线性阻尼 -->
      <angular>0.01</angular> <!-- 车轮角阻尼 -->
    </damping>
  </gazebo>
</robot>